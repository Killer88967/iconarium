{
  "name": "iconarium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "scripts": {
    "dev": "pnpm --filter @iconarium/web dev",
    "build": "pnpm generate && pnpm -r --if-present build",
    "generate": "tsx generators/generate-all.ts",
    "generate:format": "tsx generators/generate-all.ts && pnpm dlx prettier -w ./",
    "generate:font-awesome": "tsx generators/providers/font-awesome/generate.ts",
    "generate:devicons": "tsx generators/providers/devicons/generate.ts",
    "generate:simple-icons": "tsx generators/providers/simple-icons/generate.ts",
    "generate:octicons": "tsx generators/providers/octicons/generate.ts",
    "generate:iconarium": "tsx generators/providers/iconarium/generate.ts",
    "generate:used:oct": "tsx generators/web/generate-used-octicons.ts && pnpm format:used",
    "generate:used:icn": "tsx generators/web/generate-used-iconarium.ts && pnpm format:used",
    "generate:used:dev:oct": "tsx watch --clear-screen=false --include \"apps/web/**/*.tsx\" generators/web/generate-used-octicons.ts",
    "generate:used:dev:icn": "tsx watch --clear-screen=false --include \"apps/web/**/*.tsx\" generators/web/generate-used-iconariumts",
    "format:used": "prettier -w ./apps/web/generated/",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "node scripts/clean.mjs",
    "git": "git add . && git commit -m \"Update\" && git push"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
