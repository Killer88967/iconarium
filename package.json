{
  "name": "icon-meta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @icon-meta/web dev",
    "build": "pnpm generate && pnpm -r --if-present build",
    "generate": "tsx generators/generate-all.ts",
    "generate:font-awesome": "tsx generators/providers/font-awesome/generate.ts",
    "generate:devicons": "tsx generators/providers/devicons/generate.ts",
    "generate:simple-icons": "tsx generators/providers/simple-icons/generate.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
